# Copy to bambu-statusd.env (same directory) and fill in real values -
# bambu-statusd.env is what the systemd unit reads and should NOT be
# committed anywhere the access code shouldn't be visible.
#
# IP: printer's LAN IP (set a DHCP reservation for it, the socket bridge
# assumes it doesn't move).
# SERIAL: Settings (gear icon) -> General -> Device -> Serial Number.
# ACCESS_CODE: Settings -> General -> "LAN Only Mode" section, the
# hexadecimal code shown once it's enabled.
BAMBU_IP=192.168.1.XXX
BAMBU_SERIAL=YOUR_PRINTER_SERIAL
BAMBU_ACCESS_CODE=YOUR_LAN_ACCESS_CODE
