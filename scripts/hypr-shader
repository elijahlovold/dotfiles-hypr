#!/bin/sh
# Hyprland screen shader switcher (decoration:screen_shader), for the
# Super+P keytree's Shaders/ menu. Shaders live in hypr/shaders/, generated
# by hypr-shader-port from hypr/shaders/src/ (or from ghostty-shaders/).
#
#   hypr-shader NAME      turn NAME on, or off if it's already on
#   hypr-shader off
#   hypr-shader status    current shader name, or "off"
#   hypr-shader list
#   hypr-shader refresh   re-apply the current shader (after monitors change)
#
# Damage tracking (debug:damage_tracking) is set per shader:
#   static   -> 1 (monitor): any change redraws the whole monitor. Partial
#               redraws (2, the default) break shaders that read other
#               pixels than the one they write - CRT curvature, bloom - and
#               they flicker as stale regions alternate between buffers.
#   animated -> 0 (none): needed for Hyprland's `time` uniform to update,
#               plus debug:vfr off - otherwise Hyprland only renders a
#               frame when something changes, and the animation only moves
#               when the mouse does. Together: the whole monitor is redrawn
#               every refresh while one is on.
#   off      -> 2 again, vfr back on.
#
# Rotated monitors: the shader sees each monitor's raw, unrotated buffer.
# The copy actually loaded ($XDG_RUNTIME_DIR/hypr-shader/NAME.frag) gets
# every monitor's rotation baked in, keyed by monitor id - the shader's
# hyprTransform() - so effects point the same way on all of them. Ids and
# rotations come from `hyprctl monitors` at apply time, so a monitor change
# needs `hypr-shader refresh` (hypr-toggle-monitors runs it).
#
# Changes are made at runtime with `hyprctl eval`, so a config reload
# (Super+Shift+R) also turns the shader off; the state file is just what
# this script last set.

set -u

shader_dir=$(dirname -- "$(realpath -- "$0")")/../hypr/shaders
shader_dir=$(realpath -- "$shader_dir")
state=${XDG_RUNTIME_DIR:-/tmp}/hypr-shader.state
build_dir=${XDG_RUNTIME_DIR:-/tmp}/hypr-shader

die() {
    printf '%s\n' "hypr-shader: $*" >&2
    exit 1
}

notify() {
    [ "${quiet:-}" = 1 ] && return
    notify-send -a Hyprland -u low -t 1500 "Screen shader" "$1" >/dev/null 2>&1 || true
}

current() {
    [ -f "$state" ] && cat "$state" || echo off
}

# $1 = shader path ("" = none), $2 = damage tracking mode, $3 = vfr,
# $4 = extra hl.config entries (optional)
apply() {
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$1\" }, debug = { damage_tracking = $2, vfr = $3 }${4:+, $4} })" >/dev/null ||
        die "hyprctl eval failed"
}

# Turning the shader off makes Hyprland (0.56) redraw each monitor in full
# only twice (m_forceFullFrames = 2), and those forced frames aren't added
# to the damage history used to repair recycled buffers. With 3 buffers in
# the swapchain, the third still holds a shader frame; back on partial
# redraws, each later frame only repaints what changed since that buffer's
# last use, so the stale shader frame keeps flashing through until
# something damages the whole monitor (e.g. focusing it). Re-setting
# general:border_size (to its current value) makes Hyprland damageMonitor()
# every monitor, which does go into that history, so every buffer gets
# fully repainted.
off() {
    border=$(hyprctl getoption general:border_size -j | jq -er .int) || die "couldn't read general:border_size"
    apply "" 2 true "general = { border_size = $border }"
    rm -f "$state"
    notify "Off"
}

# Copy of shader $1 with each monitor's transform filled into the
# `// @transforms@` slot (only rotations 0-3; flipped transforms count as
# their rotation). Prints the copy's path.
build() {
    mkdir -p "$build_dir" || die "can't create $build_dir"
    cases=$(hyprctl monitors -j | jq -r '.[] | "    if (wl_output == \(.id)) return \(.transform % 4);"') ||
        die "couldn't read monitors"
    out="$build_dir/$1.frag"
    awk -v cases="$cases" '$0 == "    // @transforms@" { print cases; next } { print }' "$2" >"$out" ||
        die "couldn't write $out"
    printf '%s\n' "$out"
}

on() {
    name=$1
    [ "${2:-}" = quiet ] && quiet=1
    src="$shader_dir/$name.frag"
    [ -f "$src" ] || die "no shader '$name' in $shader_dir (try: hypr-shader list)"
    file=$(build "$name" "$src") || exit 1
    if grep -q '^// animated: yes' "$src"; then
        apply "$file" 0 false
        notify "$name (animated - full redraw every frame)"
    else
        apply "$file" 1 true
        notify "$name"
    fi
    printf '%s\n' "$name" >"$state"
}

case ${1:-} in
    "" | -h | --help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    status)
        current
        ;;
    list)
        for f in "$shader_dir"/*.frag; do
            n=$(basename "$f" .frag)
            if grep -q '^// animated: yes' "$f"; then
                printf '%s\tanimated\n' "$n"
            else
                printf '%s\tstatic\n' "$n"
            fi
        done
        ;;
    off)
        off
        ;;
    refresh)
        name=$(current)
        [ "$name" = off ] || on "$name" quiet
        ;;
    *)
        if [ "$(current)" = "$1" ]; then
            off
        else
            on "$1"
        fi
        ;;
esac
