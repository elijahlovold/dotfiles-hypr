#!/usr/bin/env python3
"""Convert Ghostty/Shadertoy-style shaders into Hyprland screen shaders.

    hypr-shader-port [SRC_DIR] [OUT_DIR] [NAME...]

Defaults: SRC_DIR = ghostty-shaders/ and OUT_DIR = hypr/shaders/ next to
this repo's scripts/ dir; no NAMEs = every *.glsl in SRC_DIR.

Ghostty shaders define mainImage(out vec4, in vec2 fragCoord) and read
iChannel0/iResolution/iTime. Hyprland's screen shader (decoration:
screen_shader) is a GLSL ES 3.00 fragment shader with `in vec2 v_texcoord`,
`uniform sampler2D tex` (the composited monitor) and optionally
`uniform float time`. This wraps the original in that interface and fixes
the desktop-GLSL leniencies GLES rejects (int->float, `{}` initializers).

A shader that reads iTime ends up using Hyprland's `time` uniform, which
only updates with debug:damage_tracking = 0 (full redraw every frame). The
output's second line says which (`// animated: yes|no`) for hypr-shader.
"""
import os
import re
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(HERE)

HEADER = """#version 300 es
// Generated by scripts/hypr-shader-port from {src} - edit the original
// and regenerate rather than this file.
precision highp float;
precision highp int;
in vec2 v_texcoord;
uniform sampler2D tex;
uniform float time;
layout(location = 0) out vec4 hyprFragColor;

#define iChannel0 tex
#define iTime time
#define iResolution vec3(hyprLogicalSize(), 1.0)
#define iTimeDelta (1.0 / 60.0)
#define iFrame int(time * 60.0)
#define iMouse vec4(0.0)

// Coordinates. Hyprland hands the screen shader the monitor's raw buffer
// (v_texcoord top-down, before the monitor's rotation), while Shadertoy
// code works bottom-up in the screen as you see it. So fragCoord is mapped
// into that upright, bottom-up space and every texture lookup back again.
//
// Which rotation applies depends on the monitor being drawn (`wl_output` =
// its id, as in `hyprctl monitors`); hypr-shader fills in hyprTransform()
// from the live monitor list when it applies the shader. Unfilled (e.g.
// loading this file directly), every monitor is treated as unrotated.
uniform int wl_output;
int hyprTransform() {
    // @transforms@
    return 0;
}

// Upright top-down -> raw buffer, per wl_output transform 0-3 (90/180/270;
// 90 and 270 matched to how Hyprland actually rotates, checked on DP-1).
vec2 hyprToRaw(vec2 l) {
    int t = hyprTransform();
    if (t == 3) return vec2(1.0 - l.y, l.x);
    if (t == 2) return 1.0 - l;
    if (t == 1) return vec2(l.y, 1.0 - l.x);
    return l;
}
vec2 hyprToUpright(vec2 n) {
    int t = hyprTransform();
    if (t == 3) return vec2(n.y, 1.0 - n.x);
    if (t == 2) return 1.0 - n;
    if (t == 1) return vec2(1.0 - n.y, n.x);
    return n;
}
vec2 hyprLogicalSize() {
    vec2 s = vec2(textureSize(tex, 0));
    int t = hyprTransform();
    return (t == 1 || t == 3) ? s.yx : s;
}
// Shadertoy uv (bottom-up, upright) -> raw buffer texcoord.
vec2 hyprSample(vec2 p) { return hyprToRaw(vec2(p.x, 1.0 - p.y)); }
#define texture(s, p) texture(s, hyprSample(p))
#define textureLod(s, p, l) textureLod(s, hyprSample(p), l)

#line 1
"""

FOOTER = """
void main() {
    vec4 c = vec4(0.0);
    vec2 up = hyprToUpright(v_texcoord);
    mainImage(c, vec2(up.x, 1.0 - up.y) * iResolution.xy);
    hyprFragColor = vec4(c.rgb, 1.0);
}
"""


def port(s):
    # `const T[N] x = { ... };` and `const T x[N] = { ... };` (GLSL 4.2
    # initializer lists) -> array constructors.
    s = re.sub(r'const\s+(\w+)\s*\[(\d+)\]\s+(\w+)\s*=\s*\{(.*?)\};',
               lambda m: f'const {m[1]}[{m[2]}] {m[3]} = {m[1]}[{m[2]}]({m[4]});', s, flags=re.S)
    s = re.sub(r'const\s+(\w+)\s+(\w+)\s*\[(\d+)\]\s*=\s*\{(.*?)\};',
               lambda m: f'const {m[1]} {m[2]}[{m[3]}] = {m[1]}[{m[3]}]({m[4]});', s, flags=re.S)
    # Integer literals mixed into float math.
    s = re.sub(r'\b(\d+)\s*\*\s*PI\b', r'\1.0*PI', s)
    s = re.sub(r'(?<![\w.])(\d+)\s*\*\s*(?=mod\(|fragCoord)', r'\1.0*', s)
    s = re.sub(r'=\s*1\s*-\s*step\(', '= 1.0 - step(', s)
    # Hex ints in float array constructors.
    s = re.sub(r'(float\[\d+\]\()(.*?)(\);)',
               lambda m: m[1] + re.sub(r'\b(0x[0-9A-Fa-f]+)\b', r'float(\1)', m[2]) + m[3], s, flags=re.S)
    return s


def main(argv):
    src_dir = argv[0] if len(argv) > 0 else os.path.join(REPO, "ghostty-shaders")
    if not os.path.isdir(src_dir):
        sys.exit(f"hypr-shader-port: no shader source dir {src_dir} - pass one, e.g. a ghostty-shaders checkout")
    out_dir = argv[1] if len(argv) > 1 else os.path.join(REPO, "hypr", "shaders")
    names = argv[2:] or sorted(f[:-5] for f in os.listdir(src_dir) if f.endswith(".glsl"))
    os.makedirs(out_dir, exist_ok=True)
    for name in names:
        with open(os.path.join(src_dir, name + ".glsl")) as f:
            src = f.read()
        animated = "yes" if re.search(r'\biTime\b', src) else "no"
        out = f"// animated: {animated}\n" + HEADER.replace("{src}", f"ghostty-shaders/{name}.glsl") + port(src) + FOOTER
        # #version must be the first line for GLSL - move the marker after it.
        out = out.replace(f"// animated: {animated}\n#version 300 es\n", f"#version 300 es\n// animated: {animated}\n", 1)
        with open(os.path.join(out_dir, name + ".frag"), "w") as f:
            f.write(out)
        print(f"{name}.frag (animated: {animated})")


if __name__ == "__main__":
    main(sys.argv[1:])
