#!/bin/sh
# Drives (udisksctl) and MTP phones (android-file-transfer) for the
# quickshell Drives pill - every disk's filesystems, removable or not.
#
#   hypr-usb list                 JSON: {drives: [...], phones: [...], phoneMount}
#   hypr-usb open <partition>     mount if needed, open a terminal there
#   hypr-usb unmount <partition>
#   hypr-usb eject <disk>         unmount every partition, power the disk off
#   hypr-usb open-phone           aft-mtp-mount, open a terminal there
#   hypr-usb unmount-phone
#   hypr-usb gui-phone            android-file-transfer (needs the device free)
#   hypr-usb scrcpy               mirror the phone's screen (needs USB debugging)
#
# aft-mtp-mount only ever grabs the first MTP device, so there's a single
# phone mountpoint rather than one per device.

set -u

terminal=${TERMINAL:-alacritty}
phone_dir="${XDG_RUNTIME_DIR:-/tmp}/hypr-usb/phone"

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

open_terminal() {
    setsid -f "$terminal" --working-directory "$1" >/dev/null 2>&1
}

mountpoint_of() {
    lsblk -no MOUNTPOINT "$1" | head -n 1
}

list_drives() {
    # Every real filesystem: partitions (or bare filesystems) on all disks,
    # following LUKS/LVM children down to the filesystem inside. Skips swap,
    # containers without a filesystem, zram and loop devices. Sizes are
    # bytes; fsused/fsavail are null while unmounted. A btrfs filesystem with
    # several subvolume mounts reports its shortest mountpoint ("/" over
    # "/home"). Removable = USB/hotplug/rm, which is what gets eject.
    { lsblk -J -b -o NAME,PATH,LABEL,SIZE,FSTYPE,FSSIZE,FSUSED,FSAVAIL,MOUNTPOINTS,MODEL,TRAN,HOTPLUG,RM,ROTA,TYPE 2>/dev/null ||
        echo '{"blockdevices": []}'; } | jq -c '
        def truthy: . == true or . == "1" or . == 1;
        def leaves: if (.children // []) | length > 0 then .children[] | leaves else . end;
        [.blockdevices[]
         | select(.type == "disk" and (.name | test("^(zram|loop)") | not))
         | . as $disk
         | (($disk.tran == "usb") or ($disk.hotplug | truthy) or ($disk.rm | truthy)) as $removable
         | (if ($disk.name | test("^mmcblk")) or (($disk.model // "") | test("\\bSD\\b|MMC|Card"; "i")) then "sd"
            elif $disk.tran == "usb" and ($disk.rota | truthy | not) and ($disk.rm | truthy | not) then "ssd"
            elif $disk.tran == "usb" then "usb"
            elif $disk.tran == "nvme" or ($disk.name | test("^nvme")) then "nvme"
            elif ($disk.rota | truthy) then "hdd"
            else "ssd" end) as $kind
         | ($disk | leaves)
         | select(.fstype != null and (.fstype | test("^(swap|crypto_LUKS|LVM2_member|linux_raid_member)$") | not))
         | {path, label: (.label // ""), size: (.size // 0), fstype,
            mountpoint: ([(.mountpoints // [])[] | select(. != null)] | sort_by(length) | first // ""),
            fssize: .fssize, fsused: .fsused, fsavail: .fsavail,
            disk: $disk.path, diskSize: ($disk.size // 0), kind: $kind, removable: $removable,
            model: (($disk.model // "") | gsub("^\\s+|\\s+$"; ""))}]'
}

list_phones() {
    # Android exposes MTP as a vendor-class interface literally named "MTP";
    # PTP-only (camera mode) phones show up as still-image class 06.
    for iface in /sys/bus/usb/devices/*:*; do
        [ -d "$iface" ] || continue
        name=$(cat "$iface/interface" 2>/dev/null)
        class=$(cat "$iface/bInterfaceClass" 2>/dev/null)
        [ "$name" = MTP ] || [ "$class" = 06 ] || continue
        dev=${iface%:*}
        printf '%s\t%s\t%s\n' "$(basename "$dev")" \
            "$(cat "$dev/manufacturer" 2>/dev/null)" "$(cat "$dev/product" 2>/dev/null)"
    done | sort -u | jq -R -s -c '
        [split("\n")[] | select(length > 0) | split("\t")
         | {id: .[0], name: ([.[1], .[2]] | map(select(length > 0)) | join(" "))}]'
}

phone_mounted() {
    mountpoint -q "$phone_dir" 2>/dev/null
}

unmount_phone() {
    phone_mounted || return 0
    fusermount3 -u "$phone_dir" 2>/dev/null || fusermount -u "$phone_dir"
}

case ${1:-} in
list)
    mount=""
    phone_mounted && mount=$phone_dir
    jq -n -c --argjson drives "$(list_drives)" --argjson phones "$(list_phones)" \
        --arg phoneMount "$mount" '{drives: $drives, phones: $phones, phoneMount: $phoneMount}'
    ;;
open)
    [ -n "${2:-}" ] || die "usage: hypr-usb open <partition>"
    mp=$(mountpoint_of "$2")
    if [ -z "$mp" ]; then
        udisksctl mount --no-user-interaction -b "$2" >/dev/null || exit 1
        mp=$(mountpoint_of "$2")
    fi
    [ -n "$mp" ] || die "$2 has no mountpoint"
    open_terminal "$mp"
    ;;
unmount)
    [ -n "${2:-}" ] || die "usage: hypr-usb unmount <partition>"
    udisksctl unmount --no-user-interaction -b "$2" >/dev/null
    ;;
eject)
    [ -n "${2:-}" ] || die "usage: hypr-usb eject <disk>"
    for part in $(lsblk -nlo PATH,MOUNTPOINT "$2" | awk 'NF == 2 { print $1 }'); do
        udisksctl unmount --no-user-interaction -b "$part" >/dev/null || exit 1
    done
    udisksctl power-off --no-user-interaction -b "$2"
    ;;
open-phone)
    if ! phone_mounted; then
        mkdir -p "$phone_dir"
        setsid -f aft-mtp-mount "$phone_dir" >/dev/null 2>&1
        i=0
        until phone_mounted; do
            i=$((i + 1))
            [ $i -gt 20 ] && die "phone didn't mount - unlocked and set to File transfer?"
            sleep 0.5
        done
    fi
    open_terminal "$phone_dir"
    ;;
unmount-phone)
    unmount_phone
    ;;
gui-phone)
    unmount_phone
    setsid -f android-file-transfer >/dev/null 2>&1
    ;;
scrcpy)
    # adb is a separate USB interface from MTP, so this works alongside a
    # mounted phone - but only once USB debugging is on and authorised.
    state=$(adb get-state 2>&1) || die "no adb device - enable USB debugging and accept the prompt (${state##*: })"
    setsid -f scrcpy >/dev/null 2>&1
    ;;
*)
    die "usage: hypr-usb list|open|unmount|eject|open-phone|unmount-phone|gui-phone|scrcpy"
    ;;
esac
