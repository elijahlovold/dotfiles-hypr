	#define SNOW_DEPTH .5
	#define SNOW_WIDTH .3
	#define SNOW_SPEED .6
#else // BLIZZARD
	#define SNOW_LAYERS 200
	#define SNOW_DEPTH .1
	#define SNOW_WIDTH .8
	#define SNOW_SPEED 1.5
