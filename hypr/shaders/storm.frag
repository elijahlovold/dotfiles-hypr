// Storm: rain on the glass plus lightning outside it.

// ---- lib/raindrops.glsl ----
// Rain on glass: the screen is seen through a misted window with water on
// it. Drops act as little lenses (they show a flipped, wide view of what's
// behind them). Some sit and slowly evaporate; others run down in
// stick-slip hops, stretching into a teardrop as they break loose and
// pulling round again when they stop, wiping a clear trail and leaving
// droplets behind.
//
// Works in aspect-correct units: P = fragCoord / iResolution.y, so 1.0 is
// the screen height. Every drop is a signed distance shape, so stretched
// and merged drops refract the same way round ones do.

// ---- hash.glsl ----
// Integer hashes. Hash integer cell/slot ids with these, never a float
// formula on the coordinates: those are smooth in the input, so
// neighbouring cells get related values and patterns line up (the old
// just-snow hash put whole rows of flakes at the same height).

// PCG3D (Jarzynski & Olano 2020, "Hash Functions for GPU Rendering").
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

// Three independent values in [0, 1]. Mixed with the monitor id
// (wl_output, from hypr-shader-port's header), so each monitor gets its own
// random drops, strikes and flakes instead of a copy of the same pattern.
vec3 hash3(ivec3 p) {
    uvec3 v = uvec3(p);
    v.z += uint(wl_output) * 0x9E3779B9u;
    return vec3(pcg3d(v)) * (1.0 / 4294967295.0);
}
vec3 hash3(ivec2 p, int seed) { return hash3(ivec3(p, seed)); }
vec3 hash3(int a, int seed) { return hash3(ivec3(a, seed, 0x5eed)); }

// Cheaper: two values in [0, 1] at 16-bit precision, from one lowbias32
// hash (Chris Wellons) of the cell, seed and monitor folded together.
// About a quarter of hash3's work, for loops that hash dozens of times
// per pixel and only need two numbers.
vec2 hash2(ivec2 p, int seed) {
    uint x = uint(p.x) * 0x8da6b343u ^ uint(p.y) * 0xd8163841u
           ^ uint(seed) * 0xcb1ab31fu ^ uint(wl_output) * 0x9E3779B9u;
    x ^= x >> 16u; x *= 0x7feb352du;
    x ^= x >> 15u; x *= 0x846ca68bu;
    x ^= x >> 16u;
    return vec2(uvec2(x & 0xffffu, x >> 16u)) * (1.0 / 65535.0);
}

// Smooth 2D value noise in [0, 1].
float vnoise(vec2 p, int seed) {
    vec2 i = floor(p), f = fract(p);
    ivec2 c = ivec2(i);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash3(c, seed).x;
    float b = hash3(c + ivec2(1, 0), seed).x;
    float d = hash3(c + ivec2(0, 1), seed).x;
    float e = hash3(c + ivec2(1, 1), seed).x;
    return mix(mix(a, b, f.x), mix(d, e, f.x), f.y);
}

float fbm(vec2 p, int seed, int octaves) {
    float v = 0.0, amp = 0.5;
    for (int o = 0; o < octaves; o++) {
        v += amp * vnoise(p, seed + o);
        p = p * 2.03 + vec2(17.1, 9.3);
        amp *= 0.5;
    }
    return v;
}
// ---- end hash.glsl ----

#define RAIN_MIST 0.1        // how fogged the glass is between drops (0 = clear)
#define RAIN_MIST_BLUR 5.0   // mist blur radius, pixels
#define RAIN_VIEW 9.0        // a drop shows a patch this many times its size
#define RAIN_TRAIL_LIFE 4.0  // seconds a wiped trail stays clear
#define RAIN_HOPS 5          // stick-slip moves per run down a cell
#define RAIN_TAIL_LAG 0.012  // how far the tail trails the head, in cycles

struct Drop {
    vec2 off;     // refraction: where to sample instead, in P units
    float mask;   // 0..1 coverage
    float spec;   // specular highlight
    float rim;    // dark edge
};

Drop noDrop() { return Drop(vec2(0.0), 0.0, 0.0, 0.0); }

Drop pick(Drop a, Drop b) { return b.mask > a.mask ? b : a; }

// A drop from its signed distance d (negative inside), outward gradient g
// and radius r, all in P units. toHead = (p - centre) / r of its round
// head, for the highlight. For a circle the offset is -(p - c) * (VIEW + 1):
// sampling p - (VIEW + 1)(p - c) shows a patch VIEW times the drop's size,
// flipped, like a real drop.
Drop lensSdf(float d, vec2 g, float r, vec2 toHead) {
    if (d > 0.0 || r < 1e-5) return noDrop();
    float px = 1.0 / iResolution.y;
    float depth = clamp(-d / r, 0.0, 1.0);   // 0 at the edge, 1 at the centre
    Drop o;
    o.mask = smoothstep(0.0, -1.5 * px, d);
    o.off = -g * (1.0 - depth) * r * (RAIN_VIEW + 1.0);
    o.rim = smoothstep(0.35, 0.0, depth);
    o.spec = smoothstep(0.3, 0.0, length(toHead - vec2(-0.3, 0.38))) * 0.6;
    return o;
}

// Circle as (distance, gradient).
vec3 circleSdf(vec2 p, vec2 c, float r) {
    vec2 v = p - c;
    float l = length(v);
    return vec3(l - r, v / max(l, 1e-6));
}

// Tapered capsule from a (radius ra) to b (radius rb): a teardrop when
// stretched, a circle when a and b (nearly) meet. After Inigo Quilez's
// sdUnevenCapsule.
float taperSdf(vec2 p, vec2 a, vec2 b, float ra, float rb) {
    vec2 ab = b - a;
    float h = dot(ab, ab), w = ra - rb;
    if (h <= w * w + 1e-9) return length(p - a) - ra;
    p -= a;
    vec2 q = vec2(abs(dot(p, vec2(ab.y, -ab.x))), dot(p, ab)) / h;
    vec2 c = vec2(sqrt(h - w * w), w);
    float k = c.x * q.y - c.y * q.x;
    if (k < 0.0) return sqrt(h * dot(q, q)) - ra;
    if (k > c.x) return sqrt(h * (dot(q, q) + 1.0 - 2.0 * q.y)) - rb;
    return dot(c, q) - ra;
}

// A running drop: head, mid and tail points along its path, joined by two
// tapered capsules (so it bends with the path) and blended where they meet.
float runningSdf(vec2 p, vec2 head, vec2 mid, vec2 tail, float rh) {
    float a = taperSdf(p, head, mid, rh, rh * 0.72);
    float b = taperSdf(p, mid, tail, rh * 0.72, rh * 0.45);
    float k = 0.3 * rh;
    float t = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, t) - k * t * (1.0 - t);
}

// Drops that condense, sit, and evaporate. One per (scale-sized) cell at
// most, kept inside its cell so no neighbour search is needed. Their
// outlines wobble a little: water on glass is never a perfect circle.
Drop staticDrops(vec2 P, float scale, int seed) {
    vec2 q = P * scale;
    ivec2 c = ivec2(floor(q));
    vec3 h = hash3(c, seed), h2 = hash3(c, seed + 1);
    if (h2.z > 0.65) return noDrop();
    float lf = fract(iTime / mix(6.0, 14.0, h.z) + h2.x);
    float life = smoothstep(0.0, 0.04, lf) * smoothstep(1.0, 0.55, lf);
    float r = mix(0.1, 0.28, h2.y * h2.y) * life;
    if (r < 1e-3) return noDrop();
    vec2 v = q - (floor(q) + 0.3 + 0.4 * h.xy);
    float l = length(v), a = atan(v.y, v.x);
    float rr = r * (1.0 + 0.08 * sin(3.0 * a + h.x * 20.0) + 0.05 * sin(5.0 * a + h.y * 20.0));
    return lensSdf((l - rr) / scale, v / max(l, 1e-6), r / scale, v / r);
}

// How far down its cell (0..1) a running drop is at cycle phase u: RAIN_HOPS
// hops, each one waiting a random share of its slot, then breaking loose
// suddenly and slowing as it sheds water. Mostly short hops, now and then
// a long run.
float slideProgress(float u, ivec3 key) {
    u = clamp(u, 0.0, 0.9999);
    float slot = floor(u * float(RAIN_HOPS));
    float total = 0.0, done = 0.0, cur = 0.0, hold = 0.5;
    for (int i = 0; i < RAIN_HOPS; i++) {
        vec3 h = hash3(ivec3(key.xy, key.z * 16 + i));
        float dist = 0.15 + 1.6 * h.x * h.x;
        total += dist;
        if (float(i) < slot) done += dist;
        else if (float(i) == slot) { cur = dist; hold = mix(0.15, 0.9, h.y); }
    }
    float s = clamp((fract(u * float(RAIN_HOPS)) - hold) / (1.0 - hold), 0.0, 1.0);
    s = 1.0 - pow(1.0 - s, 2.2);
    return (done + cur * s) / total;
}

// Drops sliding down: columns colw wide (P units), each split into cells
// CELLH high at a per-column height offset. One drop crosses each cell per
// cycle, fading in at the top and out at the bottom so the cell edges never
// show. trail = how freshly wiped this pixel is (0..1).
Drop runningDrops(vec2 P, float colw, int seed, out float trail) {
    const float CELLH = 1.3;
    trail = 0.0;
    int ci = int(floor(P.x / colw));
    vec3 hc = hash3(ivec2(ci, 0), seed);
    float T = mix(5.0, 11.0, hc.x);
    float ty = (P.y + hc.y * CELLH) / CELLH;
    int cy = int(floor(ty));
    float fy = fract(ty);
    float cyc = iTime / T + hash3(ivec2(ci, cy), seed + 1).x;
    float u = fract(cyc);
    int n = int(floor(cyc));
    vec3 hd = hash3(ivec3(ci, cy * 977 + seed, n));
    if (hd.z < 0.25) return noDrop();   // some cycles skip, so columns go quiet
    ivec3 key = ivec3(ci, cy * 977 + seed, n);

    // Everything below is in column widths; toCol converts cell heights.
    float toCol = CELLH / colw;
    float ph = hd.y * 6.283;
    #define RAIN_PATH(y) (0.5 + 0.13 * sin((y) * 11.0 + ph) + 0.06 * sin((y) * 29.0 + ph * 2.0))
    #define RAIN_POS(prog) vec2(RAIN_PATH(mix(0.9, 0.08, prog)), mix(0.9, 0.08, prog) * toCol)
    vec2 lp = vec2(fract(P.x / colw), fy * toCol);

    float r = mix(0.1, 0.17, hd.x) * smoothstep(0.0, 0.08, u) * smoothstep(1.0, 0.88, u);
    float prog = slideProgress(u, key);
    float dropY = mix(0.9, 0.08, prog);
    vec2 head = RAIN_POS(prog);
    // The tail follows the head's path a moment behind it, so the drop
    // stretches (and bends with the path) when it breaks loose and pulls
    // back round once it stops. Capped, so a fast run doesn't snap it.
    vec2 mid = RAIN_POS(slideProgress(u - RAIN_TAIL_LAG * 0.5, key));
    vec2 tail = RAIN_POS(slideProgress(u - RAIN_TAIL_LAG, key));
    float maxS = 1.8 * r;
    vec2 dt = tail - head, dm = mid - head;
    if (length(dt) > maxS) tail = head + normalize(dt) * maxS;
    if (length(dm) > maxS * 0.5) mid = head + normalize(dm) * maxS * 0.5;
    float stretch = min(length(tail - head) / max(r, 1e-4), 1.8);
    float rh = r * (1.0 - 0.13 * stretch);   // the head thins as water runs into the tail

    Drop d = noDrop();
    if (r > 1e-4) {
        float sd = runningSdf(lp, head, mid, tail, rh);
        if (sd < 0.0) {
            float e = 0.03 * rh;
            vec2 g = vec2(runningSdf(lp + vec2(e, 0.0), head, mid, tail, rh) - sd,
                          runningSdf(lp + vec2(0.0, e), head, mid, tail, rh) - sd);
            d = lensSdf(sd * colw, normalize(g + 1e-9), rh * colw, (lp - head) / rh);
        }
    }

    // Trail above the drop, back up to where it started.
    if (fy > dropY && fy < 0.92) {
        float age = (fy - dropY) / (0.82 / T);
        float tx = lp.x - RAIN_PATH(fy);
        float w = 0.11 * smoothstep(0.92, 0.85, fy);
        trail = smoothstep(w, w * 0.4, abs(tx)) * exp(-age / RAIN_TRAIL_LIFE) * smoothstep(1.0, 0.85, u);
        // Droplets left behind along the trail, evaporating as it ages.
        float sy = lp.y / 0.32;
        float sc = floor(sy);
        vec3 hs = hash3(ivec3(ci * 31 + int(sc), cy * 977 + seed, n + 7));
        float yc = (sc + 0.5) * 0.32 / toCol;   // droplet height, cell fraction
        if (hs.x < 0.7 && yc > dropY + 0.02) {
            float ageC = (yc - dropY) / (0.82 / T);
            float rr = mix(0.025, 0.06, hs.y) * exp(-ageC / 9.0);
            vec2 cc = vec2(RAIN_PATH(yc) + (hs.z - 0.5) * 0.1, (sc + 0.5) * 0.32);
            vec3 c = circleSdf(lp, cc, rr);
            d = pick(d, lensSdf(c.x * colw, c.yz, rr * colw, (lp - cc) / max(rr, 1e-4)));
        }
    }
    #undef RAIN_POS
    #undef RAIN_PATH
    return d;
}

vec3 mistBlur(vec2 uv) {
    vec2 px = RAIN_MIST_BLUR / iResolution.xy;
    vec3 c = texture(iChannel0, uv).rgb * 2.0;
    for (int i = 0; i < 8; i++) {
        float a = float(i) * 0.785 + 0.39;
        c += texture(iChannel0, uv + vec2(cos(a), sin(a)) * px).rgb;
    }
    return c / 10.0;
}

vec3 rainOnGlass(vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    vec2 P = fragCoord / iResolution.y;

    float t1, t2;
    Drop d = runningDrops(P, 0.13, 21, t1);
    d = pick(d, runningDrops(P + vec2(0.05, 0.0), 0.085, 37, t2));
    float clear = max(t1, t2);
    // Running drops sweep the sitting ones away.
    Drop s = pick(staticDrops(P, 24.0, 3), staticDrops(P, 50.0, 5));
    s.mask *= 1.0 - clear;
    d = pick(d, s);

    vec3 sharp = texture(iChannel0, uv).rgb;
    float fog = RAIN_MIST * (1.0 - clear);
    vec3 glass = fog > 0.0 ? mix(sharp, mistBlur(uv) * 0.88 + 0.07, fog) : sharp;
    if (d.mask <= 0.0) return glass;

    vec2 suv = uv + d.off * vec2(iResolution.y / iResolution.x, 1.0);
    vec3 drop = texture(iChannel0, suv).rgb * (1.0 - 0.35 * d.rim) + d.spec;
    return mix(glass, drop, d.mask);
}
