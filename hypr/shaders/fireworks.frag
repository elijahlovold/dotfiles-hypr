// One burst, reduced to what its particles share. The original per
// particle: pos = mix(p, endP, pt) with endP = p - (0, t*t*.1) + dir
// - (0, t*.2), i.e. centre + dir * pt with centre = p + drift * pt; size as
// below; plus a sparkle of pow(.5 + .5 sin((pt + n.z) * 21), sparkK) * .01
// * B(...) (its mix(.01, .01, ...) is just .01).
struct Burst {
    vec2 centre;
    float pt, size, sparkK, sparkAmt;
    float farSq;      // a particle's size^2, averaged over its sparkle
    float radius;     // particles stay within this of the centre
    vec3 col;
};

Burst burst(vec2 p, float seed, float t) {
    vec3 en = hash31(seed);
    Burst b;
    b.pt = 1. - pow(t - 1., 2.);
    b.centre = p - vec2(0., t * t * .1 + t * .2) * b.pt;
    b.size = mix(.01, .005, S(0., .1, b.pt)) * S(1., .1, b.pt);
    b.sparkK = pow(en.x, 3.) * 50.;
    b.sparkAmt = .01 * B(en.x, en.y, en.z, t);
    // Mean of pow(.5 + .5 sin(x), k) over x is ~ 1 / sqrt(1 + pi k)
    // (exact at k = 0, right asymptotically), so the mean of
    // (size + amt * that)^2 is:
    b.farSq = b.size * b.size
            + 2. * b.size * b.sparkAmt / sqrt(1. + PI * b.sparkK)
            + b.sparkAmt * b.sparkAmt / sqrt(1. + 2. * PI * b.sparkK);
    b.radius = .5 * b.pt;   // |dir| = |n.z| <= .5
    b.col = en;
    return b;
}

float particle(vec2 uv, Burst b, vec3 n) {
    vec2 d = uv - (b.centre + n.xy * b.pt);
    float size = b.size;
    if (b.sparkAmt > 0.)
        size += pow(sin((b.pt + n.z) * 21.) * .5 + .5, b.sparkK) * b.sparkAmt;
    return size * size / dot(d, d);
}

// All of a burst's light at uv.
float burstLight(vec2 uv, Burst b) {
    float l = 0.;
    for (int k = 0; k < 12; k++) {
        vec2 d = uv - (b.centre + GROUPS[k].xy * b.pt);
        float d2 = dot(d, d);
        float far = FW_FAR_GROUP * GROUPS[k].z * b.pt;
        int first = GROUP_START[k], last = GROUP_START[k + 1];
        if (d2 > far * far)
            l += float(last - first) * b.farSq / d2;
        else
            for (int i = first; i < last; i++)
                l += particle(uv, b, PARTICLES[i]);
    }
    return l;
}

vec3 Rainbow(vec3 c) {
