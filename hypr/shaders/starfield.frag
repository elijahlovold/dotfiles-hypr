// Desktop version of ghostty-shaders/starfield.glsl for hypr-shader: the effect
// is screen-blended over everything instead of replacing dark pixels, and
// it draws 12 star layers instead of 21 (each on a finer grid, so the same
// number of stars at the same size and speed) for a little over half the
// per-pixel work.
// ---- lib/blend.glsl ----
// Screen blend: lightens base wherever fx is bright and leaves it alone
// where fx is black. For effects ported from Ghostty, which instead replace
// every dark pixel (meant for a terminal's black background, but on a
// desktop it punches holes in dark wallpaper and windows).
vec3 screenBlend(vec3 base, vec3 fx) {
    return 1.0 - (1.0 - base) * (1.0 - clamp(fx, 0.0, 1.0));
}
// ---- end lib/blend.glsl ----

// transparent background
const bool transparent = false;

// terminal contents luminance threshold to be considered background (0.0 to 1.0)
const float threshold = 0.15;

// divisions of grid (30 with the original 21 layers)
const float repeats = 40.;

// number of layers
const float layers = 12.;

// seconds a layer takes to zoom through (originally = layers = 21)
const float period = 21.;

// star colors
const vec3 white = vec3(1.0); // Set star color to pure white

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

float N21(vec2 p) {
    p = fract(p * vec2(233.34, 851.73));
    p += dot(p, p + 23.45);
    return fract(p.x * p.y);
}

vec2 N22(vec2 p) {
    float n = N21(p);
    return vec2(n, N21(p + n));
}

mat2 scale(vec2 _scale) {
    return mat2(_scale.x, 0.0,
        0.0, _scale.y);
}

// 2D Noise based on Morgan McGuire
float noise(in vec2 st) {
    vec2 i = floor(st);
    vec2 f = fract(st);

    // Four corners in 2D of a tile
    float a = N21(i);
    float b = N21(i + vec2(1.0, 0.0));
    float c = N21(i + vec2(0.0, 1.0));
    float d = N21(i + vec2(1.0, 1.0));

    // Smooth Interpolation
    vec2 u = f * f * (3.0 - 2.0 * f); // Cubic Hermite Curve

    // Mix 4 corners percentages
    return mix(a, b, u.x) +
        (c - a) * u.y * (1.0 - u.x) +
        (d - b) * u.x * u.y;
}

float perlin2(vec2 uv, int octaves, float pscale) {
    float col = 1.;
    float initScale = 4.;
    for (int l; l < octaves; l++) {
        float val = noise(uv * initScale);
        if (col <= 0.01) {
            col = 0.;
            break;
        }
        val -= 0.01;
        val *= 0.5;
        col *= val;
        initScale *= pscale;
    }
    return col;
}

vec3 stars(vec2 uv, float offset) {
    float timeScale = -(iTime + offset * period / layers) / period;
    float trans = fract(timeScale);
    float newRnd = floor(timeScale);
    vec3 col = vec3(0.);

    // Translate uv then scale for center
    uv -= vec2(0.5);
    uv = scale(vec2(trans)) * uv;
    uv += vec2(0.5);

    // Create square aspect ratio
    uv.x *= iResolution.x / iResolution.y;

    // Create boxes
    uv *= repeats;

    // Get position
    vec2 ipos = floor(uv);

    // Return uv as 0 to 1
    uv = fract(uv);

    // Calculate random xy and size
    vec2 rndXY = N22(newRnd + ipos * (offset + 1.)) * 0.9 + 0.05;
    // Stars are sized in cells; keep them the size they were on the 30 grid.
    float rndSize = (N21(ipos) * 100. + 200.) * 30. / repeats;

    vec2 j = (rndXY - uv) * rndSize;
    float sparkle = 1. / dot(j, j);

    // Set stars to be pure white
    col += white * sparkle;

    col *= smoothstep(1., 0.8, trans);
    return col; // Return pure white stars only
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    // Normalized pixel coordinates (from 0 to 1)
    vec2 uv = fragCoord / iResolution.xy;

    vec3 col = vec3(0.);

    for (float i = 0.; i < layers; i++) {
        col += stars(uv, i);
    }

    // Sample the terminal screen texture including alpha channel
    vec4 terminalColor = texture(iChannel0, uv);

    if (transparent) {
        col += terminalColor.rgb;
    }

    vec3 blendedColor = screenBlend(terminalColor.rgb, col);

    // Apply terminal's alpha to control overall opacity
    fragColor = vec4(blendedColor, terminalColor.a);
}

void main() {
    vec4 c = vec4(0.0);
    vec2 up = hyprToUpright(v_texcoord);
    mainImage(c, vec2(up.x, 1.0 - up.y) * iResolution.xy);
    hyprFragColor = vec4(c.rgb, 1.0);
}
