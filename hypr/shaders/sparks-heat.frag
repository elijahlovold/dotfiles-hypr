// Sparks + heat: the screen shimmers over the heat at the bottom while
// sparks and smoke rise through it. Only the screen behind is distorted;
// the sparks are in the hot air, not behind it.

// ---- lib/heat.glsl ----
// Heat shimmer: the screen wavers as if seen over hot asphalt, strongest at
// the bottom and fading out towards the top.

// ---- hash.glsl ----
// Integer hashes. Hash integer cell/slot ids with these, never a float
// formula on the coordinates: those are smooth in the input, so
// neighbouring cells get related values and patterns line up (the old
// just-snow hash put whole rows of flakes at the same height).

// PCG3D (Jarzynski & Olano 2020, "Hash Functions for GPU Rendering").
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

// Three independent values in [0, 1]. Mixed with the monitor id
// (wl_output, from hypr-shader-port's header), so each monitor gets its own
// random drops, strikes and flakes instead of a copy of the same pattern.
vec3 hash3(ivec3 p) {
    uvec3 v = uvec3(p);
    v.z += uint(wl_output) * 0x9E3779B9u;
    return vec3(pcg3d(v)) * (1.0 / 4294967295.0);
}
vec3 hash3(ivec2 p, int seed) { return hash3(ivec3(p, seed)); }
vec3 hash3(int a, int seed) { return hash3(ivec3(a, seed, 0x5eed)); }

// Cheaper: two values in [0, 1] at 16-bit precision, from one lowbias32
// hash (Chris Wellons) of the cell, seed and monitor folded together.
// About a quarter of hash3's work, for loops that hash dozens of times
// per pixel and only need two numbers.
vec2 hash2(ivec2 p, int seed) {
    uint x = uint(p.x) * 0x8da6b343u ^ uint(p.y) * 0xd8163841u
           ^ uint(seed) * 0xcb1ab31fu ^ uint(wl_output) * 0x9E3779B9u;
    x ^= x >> 16u; x *= 0x7feb352du;
    x ^= x >> 15u; x *= 0x846ca68bu;
    x ^= x >> 16u;
    return vec2(uvec2(x & 0xffffu, x >> 16u)) * (1.0 / 65535.0);
}

// Smooth 2D value noise in [0, 1].
float vnoise(vec2 p, int seed) {
    vec2 i = floor(p), f = fract(p);
    ivec2 c = ivec2(i);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash3(c, seed).x;
    float b = hash3(c + ivec2(1, 0), seed).x;
    float d = hash3(c + ivec2(0, 1), seed).x;
    float e = hash3(c + ivec2(1, 1), seed).x;
    return mix(mix(a, b, f.x), mix(d, e, f.x), f.y);
}

float fbm(vec2 p, int seed, int octaves) {
    float v = 0.0, amp = 0.5;
    for (int o = 0; o < octaves; o++) {
        v += amp * vnoise(p, seed + o);
        p = p * 2.03 + vec2(17.1, 9.3);
        amp *= 0.5;
    }
    return v;
}
// ---- end hash.glsl ----

#define HEAT_STRENGTH 4.0   // max displacement at the bottom, pixels
#define HEAT_HEIGHT 0.65    // fades out by this fraction of the screen height
#define HEAT_RISE 0.35      // how fast the waves rise, short sides per second

// The screen at fragCoord seen through the haze. Above HEAT_HEIGHT it's a
// plain lookup, with no noise work.
vec3 heat(vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    float amount = smoothstep(HEAT_HEIGHT, 0.0, uv.y);
    if (amount <= 0.0)
        return texture(iChannel0, uv).rgb;
    // Wave size in units of the screen's short side (its height on a
    // landscape monitor, as originally), so the waves are the
    // same size in pixels on a portrait monitor.
    vec2 P = fragCoord / min(iResolution.x, iResolution.y);
    // Rising, slowly churning turbulence: wide in x, tight in y like real
    // heat haze. The second sample drifts the other way so it never just
    // scrolls.
    float t = iTime * HEAT_RISE;
    vec2 q = vec2(P.x * 7.0, (P.y - t) * 22.0);
    float nx = fbm(q + vec2(0.0, iTime * 0.3), 41, 3) - 0.5;
    float ny = fbm(q * 0.8 + vec2(5.2, -iTime * 0.25), 43, 3) - 0.5;
    vec2 off = vec2(nx, ny * 0.6) * 2.0 * HEAT_STRENGTH * amount / iResolution.xy;
    return texture(iChannel0, uv + off).rgb;
}
// ---- end lib/heat.glsl ----
// ---- lib/sparks.glsl ----
// Sparks from a fire: glowing sparks drifting up through rising smoke,
// screen-blended over the screen. Desktop version of
// ghostty-shaders/sparks-from-fire.glsl: the effect is screen-blended over
// everything instead of replacing dark pixels, and an uninitialised
// variable is fixed (Mesa drew nothing at all). For speed, pixels a spark
// can't reach skip its noise work, and the 8 particle layers (nearly the
// same depth: each only SIZE_MOD = 5% bigger) are drawn SPARK_MERGE at a
// time on a finer grid (see layeredParticles), and the smoke uses 4 noise
// octaves instead of 6.

// ---- blend.glsl ----
// Screen blend: lightens base wherever fx is bright and leaves it alone
// where fx is black. For effects ported from Ghostty, which instead replace
// every dark pixel (meant for a terminal's black background, but on a
// desktop it punches holes in dark wallpaper and windows).
vec3 screenBlend(vec3 base, vec3 fx) {
    return 1.0 - (1.0 - base) * (1.0 - clamp(fx, 0.0, 1.0));
}
// ---- end blend.glsl ----

